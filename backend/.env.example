# ContentAgent 后端环境配置
# 复制此文件为 .env 并填入实际配置

# LLM 配置（DeepSeek）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# SiliconFlow Embedding API（用于向量生成）
# 申请地址: https://siliconflow.cn
SILICONFLOW_API_KEY=your_siliconflow_api_key

# 数据库配置（可选）
DATABASE_URL=mysql+pymysql://content_agent:content123@localhost:3306/content

# Qdrant 向量数据库（可选）
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 平台接入网关（可选，均有默认值）
GATEWAY_MOCK_INTERVAL=2.0            # 模拟源出弹幕间隔（秒）
DOUYIN_API_ENABLED=false             # 抖音官方API（需企业资质，默认禁用）
TAOBAO_API_ENABLED=false             # 淘宝官方API（需ISV资质，默认禁用）
KUAISHOU_API_ENABLED=false           # 快手官方API（需资质，默认禁用）
BROWSER_ADAPTER_ENABLED=false        # 浏览器采集适配器（Task 7 实现）

# 决策中枢（可选，均有默认值）
LLM_INTERACTION_TIMEOUT=3.0          # LLM 互动理解超时（秒），超时自动降级规则方案
DECISION_WINDOW_SECONDS=10.0         # 决策滑动窗口（秒）
DECISION_LLM_TIMEOUT=5.0             # 导演脚本 LLM 超时（秒），超时自动降级规则模板

# 实时指标与策略引擎（可选，均有默认值）
STRATEGY_WINDOW_SECONDS=60.0         # 策略滑动窗口长度（秒）
STRATEGY_EVAL_INTERVAL=10.0          # 策略评估最小间隔（秒），防抖动
STRATEGY_POPULARITY_RISE=0.2         # 人气上涨阈值（窗口内相对涨幅→促单+）
STRATEGY_POPULARITY_DROP=0.15        # 人气下跌阈值（窗口内相对跌幅→推进+）
STRATEGY_NEGATIVE_RATIO=0.3          # 负面弹幕占比阈值（→安抚+）
STRATEGY_DANMAKU_RATE_HIGH=15.0      # 高频弹幕阈值（条/分钟→答疑+）
STRATEGY_CONVERSION_HIGH=10.0        # 窗口内转化事件阈值（购物车点击+下单→促单+）
METRIC_API_PULL_ENABLED=false        # 官方API指标拉取（需平台资质，默认禁用）

# 展示适配层（TTS，可选；默认 mock 静音占位，无需任何 Key）
TTS_PROVIDER=mock                    # mock/cosyvoice/http
TTS_COSYVOICE_BASE_URL=              # 本地 CosyVoice HTTP 服务地址（如 http://localhost:9880/tts）
TTS_HTTP_BASE_URL=                   # 商用 TTS API 地址
TTS_HTTP_API_KEY=                    # 商用 TTS API 密钥
TTS_VOICE=default
TTS_OUTPUT_DIR=./tts_output

# 展示适配层（2D 数字人形象驱动，可选；默认关闭=纯声音形态）
AVATAR_ENABLED=false                 # 启用需本地/云 GPU 部署 MuseTalk/LivePortrait 推理服务
AVATAR_SERVICE_URL=                  # 推理服务地址（约定 POST /render）
AVATAR_BASE_VIDEO_ID=default         # 底版素材ID（真人录制/照片/AI生成，建议3~5套轮换）
AVATAR_AI_LABEL=true                 # "AI 生成内容"标识（平台报备要求）

# 服务配置
DEBUG=true
LOG_LEVEL=INFO
